{
  "name": "vallisglobal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "audit:seo": "node scripts/audit-seo.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "npm run check && npm run build && npm run test:unit && npm run audit:seo && npm run test:e2e",
    "icons:generate": "python scripts/generate-brand-icons.py",
    "images:generate": "node --env-file=.env scripts/image-generation/generate.mjs",
    "images:plan": "node scripts/image-generation/generate.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "astro": "^7.3.8",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.65.1",
    "axe-core": "^4.14.0",
    "lighthouse": "^13.6.0",
    "node-html-parser": "^9.0.7",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
