# Keep previews non-indexable. Enable only for the approved production launch.
PUBLIC_INDEXABLE=false

# Catalogue download lead form: URL that receives a JSON POST of each lead (e.g. a Formspree,
# Web3Forms or CRM webhook endpoint). Leave empty to show the form without storing leads.
PUBLIC_LEAD_ENDPOINT=

# Build-time AI image generation (server-side script only; never exposed to the browser).
OPENAI_API_KEY=
# Optional overrides � defaults live in scripts/image-generation/config.mjs
# OPENAI_IMAGE_MODEL_FLARE=gpt-image-2.5-flare
# OPENAI_IMAGE_MODEL_SUNBURST=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY_DEFAULT=medium
# OPENAI_IMAGE_QUALITY_PREMIUM=high
