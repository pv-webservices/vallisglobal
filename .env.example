# ---------------------------------------------------------------------------
# Enquiry email (Vercel Function: api/enquiry.js)
# Set these in Vercel → Project → Settings → Environment Variables (Production).
# Never commit real values. SMTP_PASS must be marked Sensitive.
# ---------------------------------------------------------------------------
# GoDaddy Microsoft 365 / Workspace Email SMTP (MX: smtp.secureserver.net)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
# Full mailbox address used to log in, e.g. info@vallisglobal.in
SMTP_USER=
# Mailbox password (secret)
SMTP_PASS=
# Where enquiries are delivered
MAIL_TO=info@vallisglobal.in
# Envelope/From address — must be the same mailbox as SMTP_USER so SPF/DMARC pass
MAIL_FROM=info@vallisglobal.in
# Optional: extra comma-separated origins allowed to post the form (e.g. a custom preview domain)
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Indexing
# On Vercel only the Production deployment is indexable (VERCEL_ENV=production).
# For local/other builds, set PUBLIC_INDEXABLE=false to emit noindex on every page.
# ---------------------------------------------------------------------------
PUBLIC_INDEXABLE=

# ---------------------------------------------------------------------------
# Build-time AI image generation (server-side script only; never exposed to the browser).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL_FLARE=gpt-image-2.5-flare
# OPENAI_IMAGE_MODEL_SUNBURST=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY_DEFAULT=medium
# OPENAI_IMAGE_QUALITY_PREMIUM=high
