---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Page Not Found" description="Return to the BUILDMART INDIA architectural hardware collection." noindex solidHeader cta={false}>
 <section class="not-found bg-deep grain">
  <div>
   <span class="eyebrow">A detail out of place</span>
   <b>404</b>
   <h1>This page couldn’t be found.</h1>
   <p>Explore our architectural hardware collection or contact us for help finding a product.</p>
   <div class="btn-row"><a class="btn" href="/products/">Explore the Catalogue <Icon name="arrow" size={16}/></a><a class="btn btn--ghost" href="/contact/">Contact Us <Icon name="arrow" size={16}/></a></div>
  </div>
 </section>
</Layout>
