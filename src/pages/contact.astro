---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import Icon from '../components/Icon.astro';
import {business,offices,categories,generated} from '../data/catalogue';
---
<Layout breadcrumbs={[{label:'Contact'}]} title="Contact & Product Enquiries" description="Contact VALLIS in Gurugram and Dubai for architectural hardware enquiries and quotations. Call +91 9990069207, +971 551504568 or email info@vallisglobal.in." cta={false} preload={generated('consultation')}>
 <PageHero label="Let’s talk about your project" title="Every great space starts with <em>a conversation.</em>" description="Share your product shortlist, preferred finishes and project requirements. We’ll help you explore the right details." image={generated('consultation')} alt="Hardware samples and architectural drawings on a walnut consultation table" crumbs={[{label:'Contact'}]} compact>
  <div class="btn-row"><a class="btn" href={`tel:${business.tel}`}><Icon name="phone" size={16}/>{business.phone}</a><a class="btn btn--ghost" href={`mailto:${business.email}`}><Icon name="mail" size={16}/>{business.email}</a></div>
 </PageHero>

 <section class="section bg-ivory" id="enquiry">
  <div class="container contact-grid">
   <div class="contact-aside">
    <span class="eyebrow" data-reveal>Product &amp; project enquiries</span>
    <h2 data-reveal style="--i:1">Let’s make the details <em>count.</em></h2>
    <p class="lead" data-reveal style="--i:2">Enquire about a product, explore a collection or discuss hardware for your next project.</p>
    <div class="contact-cards">
     <div class="contact-card" data-reveal><Icon name="phone"/><div><h3>Call us</h3><a href={`tel:${business.tel}`}>{business.phone}</a></div></div>
     <div class="contact-card" data-reveal style="--i:1"><Icon name="mail"/><div><h3>Email us</h3><a href={`mailto:${business.email}`}>{business.email}</a></div></div>
     {offices.map((o,i)=><div class="contact-card" data-reveal style={`--i:${i+2}`}><Icon name="pin"/><div><h3>{o.city}<small class="office-label">{o.label}</small></h3><p>{o.address}</p><a href={`tel:${o.tel}`}>{o.phone}</a><br/><a class="link-arrow" href={o.maps} target="_blank" rel="noopener">Open directions <Icon name="arrowUpRight" size={14}/><span class="sr-only"> (opens in a new tab)</span></a></div></div>)}
    </div>
   </div>

   <form class="contact-form" id="enquiry-form" action="/api/enquiry" method="post" data-reveal style="--i:1">
    <span class="eyebrow">Request architectural specifications</span>
    <h2>Tell us what you have in mind.</h2>
    <p class="form-intro">Fields marked * are required. Your enquiry goes straight to our team at {business.email}.</p>
    <input type="hidden" name="formType" value="enquiry"/>
    <input type="hidden" name="page" value="/contact/"/>
    <input type="hidden" name="startedAt" value=""/>
    <div class="form-grid">
     <div class="field"><label for="full-name">Full name <span aria-hidden="true">*</span></label><input id="full-name" name="name" autocomplete="name" required minlength="2" maxlength="100" aria-describedby="name-error"/><span class="field-error" id="name-error"></span></div>
     <div class="field"><label for="email">Email address <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required maxlength="150" aria-describedby="email-error"/><span class="field-error" id="email-error"></span></div>
     <div class="field"><label for="phone">Phone number <span aria-hidden="true">*</span></label><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required minlength="10" maxlength="20" aria-describedby="phone-hint phone-error"/><span class="field-hint" id="phone-hint">10–15 digits, with country code if outside India.</span><span class="field-error" id="phone-error"></span></div>
     <div class="field"><label for="company">Company <span class="muted">(optional)</span></label><input id="company" name="company" autocomplete="organization" maxlength="150"/></div>
     <div class="field full"><label for="category">Product category <span aria-hidden="true">*</span></label><select id="category" name="category" required aria-describedby="category-error"><option value="">Select a collection</option>{categories.map(c=><option value={c.name} data-slug={c.slug}>{c.name}</option>)}<option value="Multiple collections / General enquiry" data-slug="multiple">Multiple collections / General enquiry</option></select><span class="field-error" id="category-error"></span></div>
     <div class="field full"><label for="product">Product / model of interest <span class="muted">(optional)</span></label><input id="product" name="product" maxlength="250"/></div>
     <div class="field full"><label for="message">Project requirements <span aria-hidden="true">*</span></label><textarea id="message" name="message" required minlength="10" maxlength="2500" placeholder="Tell us about your project, quantities and preferred finishes…" aria-describedby="message-error"></textarea><span class="field-error" id="message-error"></span></div>
    </div>
    <div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div>
    <label class="consent"><input type="checkbox" name="consent" value="on" required aria-describedby="consent-error"/><span>I have read the <a href="/privacy-policies/">Privacy &amp; Policies</a> and agree to share these details for my enquiry. <span aria-hidden="true">*</span></span></label>
    <span class="field-error" id="consent-error"></span>
    <div id="form-error" class="form-error" role="alert" tabindex="-1"></div>
    <button class="btn btn--dark" type="submit" data-submit>Send Enquiry <Icon name="arrow" size={16}/></button>
    <p class="form-note" id="form-status">We reply from {business.email}. Prefer to talk? Call <a href={`tel:${business.tel}`}>{business.phone}</a>.</p>
   </form>
  </div>
 </section>

 <section class="section" id="location">
  <div class="container">
   <div class="locations">
    {offices.map(o=><div class="location" data-reveal>
     <div class="location-media" role="img" aria-label={`VALLIS ${o.label} in ${o.city}`}>
      <ResponsiveImage src="/images/hero/navy-marble.webp" sizes="(max-width: 1024px) 100vw, 50vw" alt="" width="1672" height="941" loading="lazy"/>
      <div class="location-pin"><Icon name="pin" size={34}/><div>VALLIS<small>{o.label} · {o.city}</small></div></div>
     </div>
     <div class="location-copy on-dark" style="background:transparent">
      <span class="eyebrow">Visit &amp; connect</span>
      <h2>Find us in <em>{o.city}.</em></h2>
      <p>{o.address}</p>
      <p><a href={`tel:${o.tel}`}>{o.phone}</a></p>
      <a class="btn" href={o.maps} target="_blank" rel="noopener">Get Directions <Icon name="arrowUpRight" size={16}/><span class="sr-only"> (opens in a new tab)</span></a>
     </div>
    </div>)}
   </div>
  </div>
 </section>

 <script>
  import {initEnquiryForm} from '../scripts/enquiry-form';
  const form=document.querySelector<HTMLFormElement>('#enquiry-form');
  if(form)initEnquiryForm(form);
 </script>
</Layout>
