---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import CollectionBento from '../components/CollectionBento.astro';
import CatalogueDownloads from '../components/CatalogueDownloads.astro';
import FireDoorHardware from '../components/FireDoorHardware.astro';
import ClientLogos from '../components/ClientLogos.astro';
import {categories,products,gallery,asset,generated,supplied,product,isPhoto} from '../data/catalogue';

// Hero: one premium boardroom scene, four brand pillars and a running strip of collections.
const heroImage=generated('hero-showroom');
const pillars=[
 {icon:'diamond',title:'Premium',sub:'Quality'},
 {icon:'shield',title:'Enhanced',sub:'Security'},
 {icon:'globe',title:'Global',sub:'Standards'},
 {icon:'handshake',title:'Trusted',sub:'Worldwide'},
];
// Each running card shows a genuine VALLIS product cut-out for its collection.
const runImages:Record<string,string>={'hotel-digital-locks':product('vac-14'),'door-hardware':product('vsmh-264'),'glass-door-handles':product('vosh-405'),'shower-hardware':product('vsh-704'),'glass-railings':product('vl-2115'),'furniture-hardware':product('vl-1802')};
const running=categories.map(c=>({name:c.name,href:`/products/${c.slug}/`,image:runImages[c.slug]??c.image}));
const benefits=[
 {icon:'diamond',title:'Considered materials',text:'Explore documented materials and grades for each product.',image:generated('craft-detail'),alt:'Brushed brass VALLIS lever handle, engraved with the VALLIS logo, on a dark oak door',caption:'Stainless steel, brass tones and aluminium alloy — documented per model.'},
 {icon:'grid',title:'Precision in the details',text:'Select fittings around your door and glass requirements.',image:generated('precision-macro'),alt:'Stainless-steel spider fitting holding four glass panels',caption:'Glass thickness, fixing conditions and door weights matter.'},
 {icon:'spark',title:'Elegant finishes',text:'Find a finish that complements your architectural palette.',image:generated('furniture-hardware-scene'),alt:'Navy kitchen cabinetry with brushed-gold handles',caption:'From brushed steel to warmer metal tones and black accents.'},
 {icon:'shield',title:'Purposeful performance',text:'Choose the right model for the demands of your space.',image:generated('healthcare-corridor'),alt:'Hospital corridor with timber doors and overhead door closers',caption:'Hotel access, busy corridors, service risers — each has its own needs.'},
 {icon:'building',title:'A complete collection',text:'From entrance locks to the finishing touch on cabinetry.',image:generated('team-consultation'),alt:'Architects reviewing door hardware samples and drawings around a meeting table',caption:'Sixteen collections, one conversation.'},
];
const featured=['VACS 12','VBL 255','VSDC 1101','VSF 91','VSH 704','VHSH 401','VRS 101','FHC 200','uPVC Casement'].map(m=>products.find(p=>p.model===m)!);
const sectors=[
 {name:'Residential Spaces',slug:'hotel-digital-locks',image:supplied('upvc-sliding-door-1'),alt:'Residential living room opening onto a pool through slim sliding doors',text:'Digital entrance locks, lever handles, uPVC windows & doors, shower cubicles and cabinet hardware for private homes.'},
 {name:'Hotels & Hospitality',slug:'hotel-digital-locks',image:asset('vallis-p13-x344'),alt:'Hotel guest room interior from the VALLIS catalogue',text:'RFID guest-room locks, door closers and refined hardware for hospitality interiors.'},
 {name:'Hospitals & Institutions',slug:'door-closers',image:generated('healthcare-corridor'),alt:'Calm hospital corridor with timber doors and overhead door closers',text:'Controlled door movement and durable fittings for busy corridors and shared spaces.'},
 {name:'Commercial Buildings',slug:'glass-fittings',image:supplied('patch-door-1'),alt:'Marble commercial lobby entered through frameless glass doors on patch fittings',text:'Patch fittings, frameless glass doors and spider fittings for open, light-filled commercial interiors.'},
 {name:'Corporate Offices',slug:'glass-door-handles',image:generated('office-entrance-people'),alt:'Business professionals walking through frameless glass doors with tall stainless pull handles',text:'Glass partitions, pull handles, floor springs and closers for contemporary workplaces.'},
 {name:'Institutional Projects',slug:'fhc-doors',image:generated('shaft-doors-scene'),alt:'Institutional service corridor with flush FHC doors',text:'FHC doors for service risers and glass systems for large public buildings.'},
];
const steps=[
 {title:'Choose the function.',text:'Consider access methods, door movement, glass connections or service-access needs first. Start with the requirements of the space.',image:generated('considered-lock'),alt:'VALLIS VACS 13 camera digital lock fitted to a walnut entrance door'},
 {title:'Find the finish.',text:'Explore the finishes documented for your chosen model, from brushed stainless steel to warmer metal tones and black accents.',image:generated('finishes'),alt:'Brushed stainless steel, satin brass, matte black and champagne gold finish samples on navy stone'},
 {title:'Confirm the fit.',text:'Check the door or glass dimensions, installation conditions and related components before finalising your product selection.',image:generated('fit-check'),alt:'Tape measure, glass sample and lever handle on architectural door drawings'},
];
// Glass railing imagery already appears in the collection grid, so the mosaic shows other applications.
const byTitle=(title:string)=>gallery.find(g=>g.title===title)!;
const mosaic=['Frameless glass entrances','A considered arrival','A frameless shower enclosure','The clarity of glass','Slim sliding doors','Sliding into calm'].map(byTitle);
---
<Layout title="The Art of Architectural Hardware" description="Explore VALLIS’ architectural hardware collection: hotel and digital locks, door hardware, glass fittings, railings, shower cubicles, uPVC windows & doors, furniture hardware and FHC doors in Gurugram." home preload="/images/generated/hero-showroom.webp">

 <!-- Hero: premium boardroom scene with a running strip of collections -->
 <section class="hero-show" data-hero aria-labelledby="hero-title">
  <div class="hero-stage">
   <div class="hero-media" aria-hidden="true"><ResponsiveImage src={heroImage} sizes="100vw" alt="" width="1536" height="1024" fetchpriority="high" decoding="async"/></div>
   <div class="hero-veil" aria-hidden="true"></div>
   <div class="container hero-copy">
    <p class="hero-kicker">Premium <i aria-hidden="true"></i> Innovative <i aria-hidden="true"></i> Durable</p>
    <h1 id="hero-title">World class <em>architectural hardware</em> for a better tomorrow</h1>
    <p class="hero-lede">Elegant design. Superior quality.<br/>Trusted worldwide.</p>
    <div class="btn-row"><a class="btn" href="/products/">Explore our range <Icon name="arrow" size={16}/></a><a class="btn btn--line" href="/contact/#enquiry">Request a quote <Icon name="arrow" size={16}/></a></div>
   </div>
   <ul class="hero-pillars" aria-label="Why VALLIS">
    {pillars.map(pl=><li><Icon name={pl.icon} size={34}/><span>{pl.title}<br/>{pl.sub}</span></li>)}
   </ul>
  </div>
  <div class="hero-run" aria-label="Product collections">
   <div class="hero-run-track">
    {[0,1].map(copy=><ul class="hero-run-group" aria-hidden={copy===1?'true':undefined}>{running.map(r=><li><a href={r.href} tabindex={copy===1?-1:undefined}><span class="hero-run-media"><ResponsiveImage class={isPhoto(r.image)?'is-photo':undefined} src={r.image} sizes="160px" alt="" width="160" height="120" loading={copy===1?'lazy':undefined}/></span><span class="hero-run-name">{r.name}</span></a></li>)}</ul>)}
   </div>
  </div>
  <p class="hero-tagline"><span>VALLIS — your global partner in architectural excellence</span></p>
 </section>

 <!-- Intro / Why choose: interactive showcase -->
 <section class="section why" id="intro" data-why>
  <div class="container">
   <div class="why-grid">
    <div class="why-head">
     <span class="eyebrow" data-reveal>Why choose VALLIS</span>
     <p class="statement" data-reveal style="--i:1">Hardware is part of how a space feels — <em>the way a door opens,</em> the line of a glass railing, the finish of a cabinet handle.</p>
     <p class="lead" data-reveal style="--i:2">VALLIS, a brand of Buildmart India, presents architectural hardware solutions for modern residential, hospitality and commercial environments — a considered range brought together under one roof in Gurugram.</p>
    </div>
    <div class="why-body">
     <ol class="why-items">
      {benefits.map((b,i)=><li data-reveal style={`--i:${i}`}>
       <button type="button" class:list={['why-item',{'is-active':i===0}]} data-why-item={i} aria-pressed={i===0?'true':'false'} aria-controls="why-stage">
        <span class="why-num">0{i+1}</span>
        <span class="why-text"><span class="why-title"><Icon name={b.icon} size={22}/>{b.title}</span><span class="why-desc"><span>{b.text}</span></span></span>
        <span class="why-bar" aria-hidden="true"><i></i></span>
       </button>
      </li>)}
     </ol>
     <a class="link-arrow" href="/about/" data-reveal>Know more about us <Icon name="arrow" size={14}/></a>
    </div>
    <div class="why-visual" data-reveal="clip">
     <figure class="why-stage" id="why-stage">
      {benefits.map((b,i)=><ResponsiveImage class={i===0?'is-active':''} src={b.image} sizes="(max-width: 1024px) 92vw, 46vw" alt={b.alt} width="1024" height="1280" loading="lazy" data-why-image={i} data-caption={b.caption}/>)}
      <figcaption class="why-caption"><small data-why-count>01 / 05</small><span data-why-caption aria-live="polite">{benefits[0].caption}</span></figcaption>
     </figure>
    </div>
   </div>
  </div>
 </section>

 <!-- Collections -->
 <section class="section bg-ivory" id="collection">
  <div class="container">
   <div class="section-head">
    <div data-reveal><span class="eyebrow">Premium collection</span><h2>Our product <em>range.</em></h2></div>
    <div class="section-head-actions" data-reveal style="--i:1"><p class="lead">A complete range of architectural hardware designed for safety, functionality and aesthetics across every space.</p><a class="link-arrow" href="/products/">View all products <Icon name="arrow" size={14}/></a></div>
   </div>
   <CollectionBento/>
  </div>
 </section>

 <!-- Featured products -->
 <section class="section featured on-dark" data-rail aria-labelledby="featured-title">
  <div class="container">
   <div class="section-head">
    <div data-reveal><span class="eyebrow">Featured luxury solutions</span><h2 id="featured-title">Signature pieces, <em>selected.</em></h2></div>
    <div class="section-head-actions" data-reveal style="--i:1"><p class="lead">Genuine catalogue models from across the collection — each with its own specifications and enquiry route.</p></div>
   </div>
   <div class="rail-track" tabindex="0" aria-label="Featured products, scroll horizontally">{featured.map(p=><ProductCard product={p}/>)}</div>
   <div class="rail-foot">
    <div class="rail-progress" aria-hidden="true"><span></span></div>
    <div class="rail-controls"><button class="round-btn" data-direction="-1" aria-label="Previous products"><Icon name="arrowLeft" size={20}/></button><button class="round-btn" data-direction="1" aria-label="Next products"><Icon name="arrow" size={20}/></button></div>
    <a class="link-arrow" href="/products/#catalogue-search">All products <Icon name="arrow" size={14}/></a>
   </div>
  </div>
 </section>

 <!-- Spaces -->
 <section class="section" aria-labelledby="spaces-title">
  <div class="container">
   <div class="section-head">
    <div data-reveal><span class="eyebrow">Industries we serve</span><h2 id="spaces-title">Spaces that <em>inspire.</em></h2></div>
    <p class="lead" data-reveal style="--i:1">High-performance hardware solutions for residential, commercial, hospitality and infrastructure projects.</p>
   </div>
   <div class="spaces-grid" data-sectors>
    <ol class="sector-list">
     {sectors.map((s,i)=><li class:list={['sector',{'is-active':i===0}]} data-index={i} data-reveal style={`--i:${i%3}`}>
      <a href={`/products/${s.slug}/`}>
       <span class="sector-num">0{i+1}</span>
       <div><h3>{s.name}</h3><p>{s.text}</p></div>
       <span class="sector-arrow" aria-hidden="true"><Icon name="arrowUpRight" size={18}/></span>
       <ResponsiveImage class="sector-thumb" src={s.image} sizes="90vw" alt="" width="900" height="506" loading="lazy"/>
      </a>
     </li>)}
    </ol>
    <div class="sector-visual" aria-hidden="true">
     {sectors.map((s,i)=><ResponsiveImage class={i===0?'is-active':''} src={s.image} sizes="50vw" alt="" width="900" height="990" loading="lazy"/>)}
     <div class="sector-caption"><span data-sector-label>{sectors[0].name}</span><span>VALLIS</span></div>
    </div>
   </div>
  </div>
 </section>

 <!-- Corporate image: client and institutional associations -->
 <ClientLogos/>

 <!-- Fire door hardware explorer -->
 <FireDoorHardware/>

 <!-- Process: sticky storytelling -->
 <section class="section bg-stone process" aria-labelledby="process-title" data-process>
  <div class="container">
   <div class="section-head">
    <div data-reveal><span class="eyebrow">A considered choice</span><h2 id="process-title">Function. Finish. <em>Fit.</em></h2></div>
    <div class="section-head-actions" data-reveal style="--i:1"><p class="lead">Each architectural detail has a job to do. We help you explore the documented product range with attention to application, compatibility and finish.</p></div>
   </div>
   <div class="process-grid">
    <div class="process-visual" aria-hidden="true">
     <div class="process-frame">
      {steps.map((st,i)=><ResponsiveImage class={i===0?'is-active':''} src={st.image} sizes="(max-width: 1024px) 92vw, 44vw" alt="" width="1024" height="1024" loading="lazy" data-step-image={i}/>)}
      <span class="process-badge"><b data-step-count>01</b><small>/ 03</small></span>
     </div>
    </div>
    <ol class="steps">
     {steps.map((st,i)=><li class:list={['step',{'is-active':i===0}]} data-step={i}><b>0{i+1}</b><div><h3>{st.title}</h3><p>{st.text}</p><ResponsiveImage class="step-thumb" src={st.image} sizes="92vw" alt={st.alt} width="900" height="600" loading="lazy"/></div></li>)}
    </ol>
   </div>
   <div class="btn-row process-cta" data-reveal><a class="btn btn--dark" href="/contact/#enquiry">Discuss your project <Icon name="arrow" size={16}/></a><a class="link-arrow" href="/products/">Browse all collections <Icon name="arrow" size={14}/></a></div>
  </div>
 </section>

 <!-- Gallery teaser -->
 <section class="section bg-deep" aria-labelledby="gallery-title">
  <div class="container">
   <div class="section-head">
    <div data-reveal><span class="eyebrow">Application gallery</span><h2 id="gallery-title">Architectural <em>inspiration.</em></h2></div>
    <div class="section-head-actions" data-reveal style="--i:1"><p class="lead" style="color:var(--muted-light)">Light, glass and metal working together — application imagery from the VALLIS catalogues.</p><a class="link-arrow" href="/gallery/">Open the gallery <Icon name="arrow" size={14}/></a></div>
   </div>
   <div class="mosaic">{mosaic.map((g,i)=><a href="/gallery/" data-reveal="fade" style={`--i:${i}`}><ResponsiveImage src={g.image} sizes={i===0?'(max-width: 760px) 100vw, 58vw':'(max-width: 760px) 50vw, 33vw'} alt={g.alt} width="900" height="570" loading="lazy"/><span><small>{g.group}</small>{g.title}</span></a>)}</div>
   <p class="source-note">Application imagery from the supplied catalogues, presented as inspiration — not as completed VALLIS projects.</p>
  </div>
 </section>

 <!-- Catalogues -->
 <section class="section" aria-labelledby="catalogues-title">
  <div class="container">
   <div class="section-head">
    <div data-reveal><span class="eyebrow">Look a little closer</span><h2 id="catalogues-title">The complete <em>catalogues.</em></h2></div>
    <p class="lead" data-reveal style="--i:1">Explore the supplied collections in full. For current availability, finishes and project suitability, speak to our team.</p>
   </div>
   <CatalogueDownloads/>
  </div>
 </section>

 <script>import '../scripts/home.ts';</script>
</Layout>
